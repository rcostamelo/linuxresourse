# ---- servidor ----
# Porta do painel (fora das faixas comuns e da faixa efêmera)
PORT=10450
# Interface de escuta: 127.0.0.1 = só local, 0.0.0.0 = exposto na rede
HOST=127.0.0.1

# ---- banco de dados (SQLite) ----
# Diretório onde fica linux-resource.db (usuários e sessões)
DATA_DIR=./data

# ---- sessão ----
# Tempo de vida da sessão, em dias
SESSION_TTL_DAYS=7
# Tentativas de login erradas antes do bloqueio temporário
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MIN=15

# ---- binários (ajuste se não estiverem no PATH) ----
# DU_BIN=du
# PING_BIN=ping
# DOCKER_BIN=docker

# ---- proxy reverso ----
# Defina 1 para confiar em X-Forwarded-For/X-Forwarded-Proto (HTTPS + IP real)
# TRUST_PROXY=1

# ---- docker (ver docker-compose.yml) ----
# GID do grupo docker do host: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
# Prefixo do filesystem do host quando rodando em modo host (docker-compose.host.yml)
# SCAN_ROOT=/host
