# ---- servidor ----
# Porta do painel (fora das faixas comuns e da faixa efêmera)
PORT=10450
# Interface de escuta: 127.0.0.1 = só local, 0.0.0.0 = exposto na rede
HOST=127.0.0.1

# ---- banco de dados (SQLite) ----
# Diretório onde fica linux-resource.db (usuários e sessões)
DATA_DIR=./data

# ---- sessão ----
# Tempo de vida da sessão, em dias
SESSION_TTL_DAYS=7
# Tentativas de login erradas antes do bloqueio temporário
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MIN=15

# ---- binários (ajuste se não estiverem no PATH) ----
# DU_BIN=du
# PING_BIN=ping
# DOCKER_BIN=docker
# SSH_BIN=ssh
# SSHPASS_BIN=sshpass   # só para autenticação por SENHA na aba SSH

# ---- SSH (aba de servidores remotos) ----
# SSH_CONNECT_TIMEOUT=8      # segundos para conectar
# SSH_COMMAND_TIMEOUT=20     # segundos para o comando de coleta
# SSH_CONCURRENCY=6          # servidores coletados em paralelo
# SSH_CACHE_SEC=4            # cache do último snapshot por servidor
# Arquivo de config lido para listar apelidos no modo "Sistema" (ssh-agent/ssh/config)
# SSH_CONFIG_FILE=~/.ssh/config
# Chave mestra para cifrar credenciais (modos Chave/Senha). Se vazio, é gerada em DATA_DIR/master.key (0600).
# O modo "Sistema" não guarda segredo, então não precisa da chave mestra.
# MASTER_KEY=<64 caracteres hexadecimais>   # ex.: openssl rand -hex 32

# ---- proxy reverso ----
# Defina 1 para confiar em X-Forwarded-For/X-Forwarded-Proto (HTTPS + IP real)
# TRUST_PROXY=1

# ---- docker (ver docker-compose.yml) ----
# GID do grupo docker do host: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
# Prefixo do filesystem do host quando rodando em modo host (docker-compose.host.yml)
# SCAN_ROOT=/host
