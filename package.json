{
  "name": "linux-resource",
  "private": true,
  "version": "1.0.12",
  "type": "module",
  "description": "Painel de gerenciamento e monitoramento para desktops e servidores Linux",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,magenta \"node --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "server": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "tsc -b && vite build",
    "build:deb": "bash scripts/build-deb.sh",
    "test:updater": "node tests/updater.test.mjs",
    "preview": "vite preview",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "docker:build": "docker build -t linux-resource .",
    "docker:up": "docker compose up -d --build",
    "docker:host": "docker compose -f docker-compose.host.yml up -d --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^14.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
